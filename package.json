		"@tailwindcss/vite": "4.3.4",
		"@types/node": "26.6.6",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"@vite-pwa/assets-generator": "2.0.0",
		"@vite-pwa/astro": "2.0.0",
		"@vite-pwa/workbox-window": "8.0.13",
		"astro": "7.4.5",
		"clsx": "2.1.1",
		"mutative": "2.0.2",
		"next-themes": "0.4.6",
		"radix-themes-tw": "1.1.0",
		"react": "19.3.1",
		"react-dom": "19.3.1",
		"serwist": "9.5.13",
